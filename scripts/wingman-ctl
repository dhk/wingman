#!/usr/bin/env bash
# wingman-ctl — manage wingman processes: what's running, start/stop, upgrade.
#
# The two kinds of wingman-mcp process, and why they're treated differently:
#   * the HTTP server ('wingman-mcp --http'): YOURS. Started here, stopped
#     here, tracked by a verified pidfile ('wingman mcp status|stop', RFC-032).
#   * stdio servers (no --http): spawned by Claude Desktop / Claude CLI
#     sessions, one each. They belong to those clients — killing one breaks
#     its session's tools until the client restarts. stop-all does kill them
#     (that's the point, at upgrade time), and says what must be restarted.
set -u

# $WINGMAN_REPO wins if already exported (unchanged). Otherwise, before
# falling back to the historical Mac default, check the canonical host
# settings file (~/.config/wingman/wingman.env, RFC-046/#122 — WINGMAN_REPO
# is a non-secret setting, so it lives there rather than in secrets.env)
# for a WINGMAN_REPO= line: read as data via grep, never sourced, so a
# file in the same directory as real API keys is never at risk of having
# its content executed. This closes the same gap alexandria#31 found and
# fixed for ALEXANDRIA_REPO: a tool invoked from a context that never
# exported the variable (a fresh SSH session before .bashrc runs, cron,
# 'sudo -u dhk wingman-ctl ...') silently fell back to a path that only
# makes sense on the Mac.
_wingman_repo_from_host_file() {
  local file="$HOME/.config/wingman/wingman.env" line
  [ -f "$file" ] || return 1
  line=$(grep -m1 '^WINGMAN_REPO=' "$file" 2>/dev/null) || return 1
  line="${line#WINGMAN_REPO=}"
  line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
  line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace
  [ -n "$line" ] && printf '%s\n' "$line"
}

if [ -n "${WINGMAN_REPO:-}" ]; then
  REPO="$WINGMAN_REPO"
elif _host_repo="$(_wingman_repo_from_host_file)" && [ -n "$_host_repo" ]; then
  REPO="$_host_repo"
else
  REPO="$HOME/Documents/dev/wingman"
fi
unset _host_repo
case "$(uname -s)" in
  Darwin) LOG="${WINGMAN_LOG:-$HOME/Library/Logs/wingman-mcp.log}" ;;
  *)      LOG="${WINGMAN_LOG:-$HOME/.local/state/wingman-mcp.log}" ;;
esac

say() { printf '%s\n' "$*"; }

# The arguments this run was invoked with, kept so a re-exec below can
# reproduce it exactly.
WINGMAN_CTL_ARGV=("$@")

_self_fingerprint() {
  # 'cksum', not sha256sum/shasum: the former is POSIX and present on both
  # macOS and Linux, and this only needs "did the file change", not a
  # cryptographic guarantee.
  local self
  self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" || return 1
  [ -f "$self" ] || return 1
  cksum "$self" 2>/dev/null | awk '{print $1, $2}'
}

reexec_if_self_changed() {
  # A 'git pull' can update THIS script. Without this, every step after the
  # pull keeps running the PRE-pull copy: the new logic is on disk and the old
  # logic is what executes. Invisible except in exactly the case where the new
  # behaviour was the point of pulling (#292).
  #
  # Re-running from the top is safe: the pull that triggered this is a no-op
  # the second time, so the fingerprint matches and this returns immediately.
  local before="$1" after
  after="$(_self_fingerprint)" || return 0
  if [ -z "$before" ] || [ "$before" = "$after" ]; then
    return 0
  fi
  if [ -n "${WINGMAN_CTL_REEXECED:-}" ]; then
    # Already restarted once and it changed again — a concurrent pull, or a
    # checkout being written while this runs. Do not loop; say so and go on.
    say "  (wingman-ctl changed again after restarting once — continuing with this copy)"
    return 0
  fi
  say "→ that pull updated wingman-ctl itself — restarting so the rest of this run uses it"
  export WINGMAN_CTL_REEXECED=1
  exec "$0" ${WINGMAN_CTL_ARGV[@]+"${WINGMAN_CTL_ARGV[@]}"}
}

http_running() { wingman mcp status 2>/dev/null | grep -q 'is running'; }

print_urls() {
  # Computed straight from the token file + Tailscale detection (#94,
  # #122) — works regardless of how the server was launched (wg, systemd,
  # by hand), unlike grepping a banner that only 'wg start' ever wrote.
  wingman mcp url 2>/dev/null | sed 's/^/  /'
}

check_tailscale() {
  # Offers to bring Tailscale up when it's why 'wingman mcp url' has no
  # tunnel hostname to print (#94) — reuses that exact detection (itself
  # 'tailscale status --json', mcp_server._tailscale_dns_name) rather than
  # a second, bash-side notion of "is Tailscale up." Never auto-runs —
  # 'tailscale up' can prompt for interactive login, and #94 asks for an
  # offer, not a silent action, same as cmd_stop_all's confirmation below.
  command -v tailscale >/dev/null 2>&1 || return 0
  wingman mcp url 2>/dev/null | grep -q 'no tunnel hostname detected' || return 0
  say ""
  say "Tailscale has no tunnel hostname for this box — wingman is only"
  say "reachable at http://127.0.0.1:<port> until it's up."
  say "Start it now with 'sudo tailscale up'? [y/N]"
  read -r answer
  case "$answer" in
    y|Y) sudo tailscale up ;;
    *)   say "Skipping — run 'sudo tailscale up' manually when ready." ;;
  esac
}

stdio_pids() {
  # wingman-mcp processes WITHOUT --http: the client-owned stdio servers.
  pgrep -f 'wingman-mcp' 2>/dev/null | while read -r pid; do
    cmd=$(ps -p "$pid" -o command= 2>/dev/null)
    case "$cmd" in
      *wingman-mcp*--http*) ;;                 # ours; managed via the pidfile
      *wingman-mcp*) printf '%s\n' "$pid" ;;
    esac
  done
}

owner_of() {
  tty=$(ps -p "$1" -o tty= 2>/dev/null | tr -d ' ')
  case "$tty" in
    '??'|'?'|'') say "Claude Desktop (GUI-spawned)" ;;
    *)           say "a Claude CLI session on $tty" ;;
  esac
}

cmd_status() {
  say "wingman $(wingman --version 2>/dev/null | awk '{print $2}')"
  say ""
  say "HTTP server (yours):"
  say "  $(wingman mcp status 2>/dev/null || say 'wingman not installed?')"
  http_running && print_urls
  say ""
  say "Client-owned stdio servers:"
  found=0
  for pid in $(stdio_pids); do
    found=1
    say "  pid $pid — owned by $(owner_of "$pid")"
  done
  [ "$found" = 0 ] && say "  none"
  say ""
  say "Safe to stop? 'wingman mcp stop' / '$0 stop' touch only the HTTP server."
  say "'$0 stop-all' also kills the client-owned ones — their sessions lose"
  say "wingman until you restart that client (Desktop: reopen app; CLI: /exit + relaunch)."
}

cmd_start() {
  if http_running; then
    wingman mcp status
    print_urls
    check_tailscale
    return 0
  fi
  mkdir -p "$(dirname "$LOG")"
  nohup wingman-mcp --http >"$LOG" 2>&1 &
  disown 2>/dev/null || true
  sleep 2
  if ! http_running; then
    say "START FAILED — last log lines:"
    tail -8 "$LOG" | sed 's/^/  /'
    say "(orphaned port-holder? 'wingman mcp status' names it; 'wingman mcp stop' clears it)"
    return 1
  fi
  wingman mcp status
  print_urls
  check_tailscale
  say "log: $LOG"
}

cmd_stop() { wingman mcp stop; }

cmd_stop_all() {
  force="${1:-}"
  pids=$(stdio_pids)
  if [ -n "$pids" ] && [ "$force" != "-y" ]; then
    say "This will also kill client-owned servers:"
    for pid in $pids; do say "  pid $pid — $(owner_of "$pid")"; done
    say "Those clients lose wingman until restarted. Continue? [y/N]"
    read -r answer
    case "$answer" in y|Y) ;; *) say "aborted; only run '$0 stop' for the HTTP server."; return 1 ;; esac
  fi
  wingman mcp stop 2>/dev/null || true
  if [ -n "$pids" ]; then
    for pid in $pids; do kill "$pid" 2>/dev/null; done
    sleep 2
    for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
    say "stdio servers stopped — restart Claude Desktop / CLI sessions to reconnect."
  fi
}

cmd_upgrade() {
  was_running=0; http_running && was_running=1
  say "→ refreshing $REPO from github…"
  # Discard any local regeneration of changelog_data.py left over from a
  # PRIOR run of this same command (below) — safe to drop unconditionally,
  # since it gets rebuilt fresh moments after this pull anyway. Without
  # this, a leftover uncommitted regeneration makes 'git pull --ff-only'
  # refuse to fast-forward the moment a new upstream commit also touches
  # that file — every future pull after any merge, not a one-off (#249).
  ( cd "$REPO" && git checkout -- src/wingman/changelog_data.py 2>/dev/null || true )
  _fingerprint_before_pull="$(_self_fingerprint || true)"
  ( cd "$REPO" && git pull --ff-only ) || { say "pull failed — nothing was touched"; return 1; }
  reexec_if_self_changed "$_fingerprint_before_pull"
  # Keeps the changelog from drifting silently (#202): regenerated fresh from
  # THIS pull's history right before the wheel that ships it gets built.
  # Best-effort — a checkout with a broken/absent git history (rare, but
  # possible on a shallow or detached clone) must never block the upgrade
  # itself over a data file nobody's waiting on.
  ( cd "$REPO" && uv run python3 scripts/generate_changelog.py ) \
    || say "  (changelog regeneration skipped — non-fatal, continuing)"
  say "→ reinstalling…"
  # Pinned to $REPO's own uv.lock: an unconstrained 'uv tool install'
  # resolves fresh and silently deploys versions nothing tested (#302).
  ( "$REPO/scripts/wingman-tool-install.sh" "$REPO" ) \
    || { say "reinstall failed — nothing was killed"; return 1; }
  # The new build may expect a host surface this box does not have yet
  # (RFC-072, #212). Checked right after the install, so the answer is about
  # the version now on disk, and printed rather than enforced — an upgrade
  # that refused to finish over a missing systemd timer would strand the box
  # mid-way for something nobody was waiting on.
  say "→ checking the host against this build's manifest…"
  wingman host-check || say "  (operational drift above — 'wingman host-check --apply' for the safe ones)"
  say "→ stopping everything on the old build…"
  cmd_stop_all -y
  if [ "$was_running" = 1 ]; then
    say "→ restarting the HTTP server on the new build…"
    cmd_start
  fi
  say ""
  wingman --version
  say "Done. Restart Claude Desktop and any CLI sessions to reconnect on the new build."
}

cmd_cycle() {
  # stop / upgrade / start in one act: unlike 'upgrade' (which only restores
  # the prior state), cycle ALWAYS ends with the HTTP server running on the
  # new build — the one-command morning refresh. Ordered pull→reinstall→
  # stop→start so a failed pull touches nothing and downtime stays minimal.
  cmd_upgrade || return 1
  if ! http_running; then
    say "→ starting the HTTP server (it was not running before the upgrade)…"
    cmd_start
  fi
}

cmd_redeploy_shared() {
  # The RFC-048 shared multi-tenant process, which is NOT this account's
  # instance: it runs as its own service account from its own checkout, so
  # 'upgrade' above never touches it (#292).
  #
  # Two things happen here because they always had to happen together, and
  # doing them by hand meant remembering to pull first or silently running a
  # stale copy of the redeploy script:
  #   1. refresh THIS checkout, since that is where the script being invoked
  #      lives (and re-exec if the pull changed wingman-ctl itself);
  #   2. run that script under sudo — it pulls the service account's own
  #      checkout, reinstalls, restarts, health-checks, and re-declares the
  #      host registry reservation (#288).
  local script="$REPO/scripts/wingman-redeploy-shared.sh"
  say "→ refreshing $REPO from github…"
  _fingerprint_before_pull="$(_self_fingerprint || true)"
  ( cd "$REPO" && git pull --ff-only ) || { say "pull failed — nothing was touched"; return 1; }
  reexec_if_self_changed "$_fingerprint_before_pull"
  if [ ! -x "$script" ]; then
    say "$script is missing or not executable — is $REPO a current checkout?"
    return 1
  fi
  say "→ redeploying the shared multi-tenant process (every tenant on it is"
  say "  briefly interrupted by the restart — expected, not a bug)…"
  sudo "$script"
}

cmd_upgrade_all() {
  # Everything on this box that runs wingman code (#375) — which is TWO
  # things, and naming only one of them was the bug. There is the
  # per-account CLI install, which is what an operator actually types
  # ('motd', 'qotd', 'tenant urls', 'tenant answers'), and there is the
  # RFC-048 shared multi-tenant process, which is what every tenant talks
  # to. They live in different checkouts under different accounts and
  # neither upgrades the other.
  #
  # This used to trigger the cross-account unit and stop. That unit's
  # WINGMAN_UPGRADE_USERS list describes shape B, which is RETIRED — so
  # "upgrade all" upgraded the accounts that serve nobody and skipped the
  # one that serves everybody. The symptom is silent and confusing: the
  # shared process ships a command hours before the operator's own CLI can
  # run it, and all you see is "No such command".
  #
  # Order is deliberate. The per-account installs are cheap and interrupt
  # nothing, so they go FIRST and prove the tree builds. The shared
  # process restart briefly cuts every tenant off, so it goes LAST.
  local accounts_ok=1 shared_ok=1

  # [0/2] The orchestrator itself, first (#407).
  #
  # The unit's ExecStart is '/root/.local/bin/wingman-upgrade-all', and root
  # is NOT one of the accounts it upgrades — so the component whose whole job
  # is preventing version skew was the one component frozen at whenever it
  # was installed. A reinstall failure was reported as "Resolved 44 packages
  # in 873ms" because the diagnosis for it, shipped in #308, was not in the
  # copy that was running.
  #
  # Refreshed HERE, by the caller, rather than by the unit refreshing itself:
  # replacing site-packages under a running Python process that imports
  # lazily is a genuinely nasty failure, and it would appear once a month at
  # 3am. Doing it before the trigger means the unit that runs next is already
  # the new one, with no self-modification anywhere.
  #
  # Best-effort. A stale orchestrator still upgrades everybody — it just
  # explains itself less well — so this must never be the thing that stops
  # the run. The nightly timer path is not covered by this; it announces its
  # own version instead, which is what makes that gap visible.
  # Through the pinned installer, never a raw 'uv tool install': an
  # unconstrained resolve silently deploys versions nothing tested (#302,
  # #319), and a test in this repo asserts no install path skips it.
  if [ -x "$REPO/scripts/wingman-tool-install.sh" ]; then
    say "→ [0/2] refreshing the upgrade orchestrator itself (root's own install)…"
    sudo env PYTHONDONTWRITEBYTECODE=1 "$REPO/scripts/wingman-tool-install.sh" "$REPO" \
      >/dev/null 2>&1 \
      || say "  (could not refresh it — continuing; it may report an older diagnosis)"
  fi

  if systemctl list-unit-files wingman-upgrade-all.service >/dev/null 2>&1; then
    say "→ [1/2] upgrading each account's own CLI (nothing is interrupted)…"
    if sudo systemctl start wingman-upgrade-all.service; then
      sudo journalctl -u wingman-upgrade-all.service --no-pager -n 10
    else
      accounts_ok=0
      say "  per-account upgrade FAILED — check: sudo systemctl status wingman-upgrade-all.service"
    fi
  else
    accounts_ok=0
    say "→ [1/2] wingman-upgrade-all.service isn't installed on this box — see docs/SERVER.md §7."
  fi

  # Attempted even when the accounts half failed: the two are independent,
  # and refusing to update the process that serves every tenant because
  # somebody's personal CLI could not be reinstalled is the wrong trade.
  say "→ [2/2] redeploying the shared multi-tenant process…"
  cmd_redeploy_shared || shared_ok=0

  # Never silent about a partial run: say which half did not happen, and
  # exit non-zero so a caller can tell. The redeploy script's own failures
  # leave the running process alone ("nothing was killed"), so a partial
  # result here means stale, not broken.
  if [ "$accounts_ok" = 1 ] && [ "$shared_ok" = 1 ]; then
    say "Done — per-account CLIs and the shared process are both current."
    return 0
  fi
  say ""
  # Two failures, two different truths — and saying the wrong one is worse
  # than saying nothing (#415). A per-account CLI that failed to install
  # leaves the previous one working: stale, nobody is down. A shared-process
  # redeploy that failed may have stopped the old process already, in which
  # case every tenant is DOWN. The old wording ("anything already running
  # was left alone") was written for the first case and printed for both.
  if [ "$accounts_ok" != 1 ]; then
    say "INCOMPLETE: the per-account CLI upgrade did not run."
    say "  Those accounts keep the build they already had — stale, not broken."
  fi
  if [ "$shared_ok" != 1 ]; then
    say "INCOMPLETE: the shared multi-tenant process did not come up cleanly."
    say "  It may have been stopped already, in which case NO TENANT IS SERVED"
    say "  right now. Read the redeploy output above — it says which. Treat an"
    say "  unconfirmed shared process as an outage, not as a stale build."
  fi
  say "Re-run once the cause is fixed."
  return 1
}

cmd_hosts() {
  # Thin wrapper over 'wingman-host-status' (#263) — the whole-box view
  # 'status' above deliberately isn't: 'status' is YOUR instance and the
  # clients attached to it, this is every wingman on the machine, its
  # build drift, and whether anything is running outside systemd's
  # control. Its own entry point rather than a 'wingman' subcommand for
  # RFC-042's reason (the 'wingman' CLI is one workspace per invocation).
  # No sudo: /health needs no token. As root it can additionally resolve
  # other accounts' systemd state.
  if ! command -v wingman-host-status >/dev/null 2>&1; then
    say "wingman-host-status isn't installed — reinstall from this checkout ('$0 upgrade')."
    return 1
  fi
  wingman-host-status "$@"
}

#: Same default as wingman-provision-shared.sh / wingman-redeploy-shared.sh.
SHARED_USER="${WINGMAN_SHARED_USER:-wingman-shared}"

require_no_args() {
  # A subcommand that takes nothing must SAY so rather than quietly doing
  # something else (#443). 'wg upgrade all' matched 'upgrade)', threw the
  # 'all' away and refreshed one account while the operator believed the
  # whole box had been done — on a pair of commands one hyphen apart whose
  # blast radius is very different. The same class of bug is already
  # documented in cmd_tenant below.
  local cmd="$1"; shift
  [ "$#" -eq 0 ] && return 0
  say "$0 $cmd: takes no arguments (got '$1')."
  case "$cmd" in
    upgrade) say "Did you mean '$0 upgrade-all'?" ;;
    stop)    say "Did you mean '$0 stop-all'?" ;;
  esac
  exit 2
}

cmd_keys() {
  # #444: the 'keys' commands live on the wingman CLI, but the account
  # whose keys need looking at is usually not the one you are logged in
  # as. sudo resets PATH, so every invocation had become
  #   sudo -iu wingman-shared bash -c 'export PATH=...; wingman keys ...'
  # which docs/SERVER.md had absorbed rather than solved, and which fails
  # two unhelpful ways: 'command not found', or -- worse -- running as the
  # wrong account and reading every tenant's keys.env as absent (#442).
  local as_shared=0 arg
  for arg in "$@"; do
    case "$arg" in
      --all-tenants|--tenant|--tenant=*) as_shared=1 ;;
    esac
  done

  if [ "$as_shared" -eq 0 ]; then
    command -v wingman >/dev/null 2>&1 || {
      say "no 'wingman' on PATH for $(id -un) — is the CLI installed for this account?"
      return 127
    }
    say "→ as $(id -un) (this account)"
    wingman keys "$@"
    return $?
  fi

  # Tenant-scoped: the registry and every tenant's keys.env belong to the
  # shared service account. Read as anyone else they come back "absent",
  # which is a permissions failure wearing a finding's costume.
  id "$SHARED_USER" >/dev/null 2>&1 || {
    say "no '$SHARED_USER' account on this box — is the RFC-048 shared process provisioned?"
    say "(override the name with WINGMAN_SHARED_USER=...)"
    return 1
  }
  say "→ as $SHARED_USER (owns the tenant registry and every tenant's keys.env)"
  sudo -iu "$SHARED_USER" bash -c \
    'export PATH="$HOME/.local/bin:$PATH"
     command -v wingman >/dev/null 2>&1 || {
       echo "no wingman on PATH for $(id -un) — run '"'"'wg upgrade-all'"'"' first" >&2
       exit 127
     }
     exec wingman keys "$@"' _ "$@"
}

cmd_tenant() {
  # Thin wrapper over the real implementation ('wingman tenant ...',
  # RFC-048 #209/#210) — same shape as every other wingman-ctl command
  # that just delegates to the Python CLI (e.g. cmd_stop). Forwards every
  # trailing flag (--port, --tunnel-prefix, --allowed-host, ...) through
  # unchanged -- these previously got silently dropped by both this
  # function AND the outer dispatch only ever passing $2/$3 along, so
  # docs/SERVER.md's own documented 'wg tenant url <slug> --port 8789'
  # never actually reached the real command.
  local sub="${1:-}" slug="${2:-}"
  case "$sub" in
    url)
      [ -n "$slug" ] || { say "usage: $0 tenant url <slug> [--port N] [--tunnel-prefix /path] ..."; return 2; }
      shift 2
      wingman tenant url "$slug" "$@" ;;
    rotate-token)
      [ -n "$slug" ] || { say "usage: $0 tenant rotate-token <slug>"; return 2; }
      shift 2
      wingman tenant rotate-token "$slug" "$@" ;;
    *)
      say "usage: $0 tenant url <slug> | tenant rotate-token <slug>"
      return 2 ;;
  esac
}

case "${1:-}" in
  status)      shift; require_no_args status "$@"; cmd_status ;;
  start)       shift; require_no_args start "$@"; cmd_start ;;
  stop)        shift; require_no_args stop "$@"; cmd_stop ;;
  stop-all)    cmd_stop_all "${2:-}" ;;
  upgrade)     shift; require_no_args upgrade "$@"; cmd_upgrade ;;
  cycle)       shift; require_no_args cycle "$@"; cmd_cycle ;;
  upgrade-all) shift; require_no_args upgrade-all "$@"; cmd_upgrade_all ;;
  redeploy-shared) shift; require_no_args redeploy-shared "$@"; cmd_redeploy_shared ;;
  hosts)       shift; cmd_hosts "$@" ;;
  keys)        shift; cmd_keys "$@" ;;
  tenant)      shift; cmd_tenant "$@" ;;
  *)
    say "usage: $0 status|hosts|keys|start|stop|stop-all [-y]|upgrade|cycle|upgrade-all|redeploy-shared|tenant ..."
    say "  status       what's running, who owns each process, what's safe to stop (YOU only)"
    say "  hosts        every wingman instance on this box: version, uptime, build drift,"
    say "               and whether any is running outside systemd's control (#263)"
    say "  start        the HTTP server (wingman-mcp --http), backgrounded + logged;"
    say "               offers to bring Tailscale up if it has no tunnel hostname (#94)"
    say "  stop         the HTTP server only (pidfile-verified; never touches clients)"
    say "  stop-all     HTTP + client-owned stdio servers (asks first; -y skips)"
    say "  upgrade      pull → reinstall → stop-all → restart HTTP if it was running (YOU only)"
    say "  cycle        stop / upgrade / start — always ends with the server running (YOU only)"
    say "  upgrade-all  EVERYTHING on this box: each account's own CLI first (nothing is"
    say "               interrupted), then the shared multi-tenant process every tenant"
    say "               talks to. Needs sudo; says which half did not happen (#375)"
    say "  redeploy-shared  pull, then redeploy the RFC-048 shared multi-tenant process"
    say "               (needs sudo; briefly interrupts every tenant on it)"
    say "  keys ...     forward to 'wingman keys' with a working PATH; tenant-scoped"
    say "               flags (--tenant/--all-tenants) run as the account that owns"
    say "               the registry, so tenant files are readable (#442, #444)"
    say "  tenant url <slug>           print a tenant's connector URLs (RFC-048, #209)"
    say "  tenant rotate-token <slug>  invalidate + reissue a tenant's token in one step,"
    say "                              no restart, no drain (RFC-048, #210)"
    exit 2 ;;
esac
