#!/usr/bin/env bash
# wingman-ctl — operate wingman on this box: what's running, upgrades, and
# the shared multi-tenant service.
#
# The shared-service model (RFC-048, #617): every person is a tenant of ONE
# shared process ('wingman-mcp' under the wingman-shared account), reached
# over OAuth. There is no per-account HTTP server any more — 'start', 'stop'
# and 'cycle' managed one and are retired; 'redeploy-shared' updates the
# process every tenant talks to, and 'upgrade' refreshes only this account's
# own CLI.
#
# stdio servers (no --http) still exist: Claude Desktop / Claude CLI sessions
# spawn one each for a local workspace. They belong to those clients —
# killing one breaks its session's tools until the client restarts.
# stop-all does kill them (that's the point, at upgrade time), and says what
# must be restarted.
set -u

# $WINGMAN_REPO wins if already exported (unchanged). Otherwise, before
# falling back to the historical Mac default, check the canonical host
# settings file (~/.config/wingman/wingman.env, RFC-046/#122 — WINGMAN_REPO
# is a non-secret setting, so it lives there rather than in secrets.env)
# for a WINGMAN_REPO= line: read as data via grep, never sourced, so a
# file in the same directory as real API keys is never at risk of having
# its content executed. This closes the same gap alexandria#31 found and
# fixed for ALEXANDRIA_REPO: a tool invoked from a context that never
# exported the variable (a fresh SSH session before .bashrc runs, cron,
# 'sudo -u dhk wingman-ctl ...') silently fell back to a path that only
# makes sense on the Mac.
_wingman_repo_from_host_file() {
  local file="$HOME/.config/wingman/wingman.env" line
  [ -f "$file" ] || return 1
  line=$(grep -m1 '^WINGMAN_REPO=' "$file" 2>/dev/null) || return 1
  line="${line#WINGMAN_REPO=}"
  line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
  line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace
  [ -n "$line" ] && printf '%s\n' "$line"
}

if [ -n "${WINGMAN_REPO:-}" ]; then
  REPO="$WINGMAN_REPO"
elif _host_repo="$(_wingman_repo_from_host_file)" && [ -n "$_host_repo" ]; then
  REPO="$_host_repo"
else
  REPO="$HOME/Documents/dev/wingman"
fi
unset _host_repo
case "$(uname -s)" in
  Darwin) LOG="${WINGMAN_LOG:-$HOME/Library/Logs/wingman-mcp.log}" ;;
  *)      LOG="${WINGMAN_LOG:-$HOME/.local/state/wingman-mcp.log}" ;;
esac

say() { printf '%s\n' "$*"; }

# The arguments this run was invoked with, kept so a re-exec below can
# reproduce it exactly.
WINGMAN_CTL_ARGV=("$@")

_self_fingerprint() {
  # 'cksum', not sha256sum/shasum: the former is POSIX and present on both
  # macOS and Linux, and this only needs "did the file change", not a
  # cryptographic guarantee.
  local self
  self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" || return 1
  [ -f "$self" ] || return 1
  cksum "$self" 2>/dev/null | awk '{print $1, $2}'
}

reexec_if_self_changed() {
  # A 'git pull' can update THIS script. Without this, every step after the
  # pull keeps running the PRE-pull copy: the new logic is on disk and the old
  # logic is what executes. Invisible except in exactly the case where the new
  # behaviour was the point of pulling (#292).
  #
  # Re-running from the top is safe: the pull that triggered this is a no-op
  # the second time, so the fingerprint matches and this returns immediately.
  local before="$1" after
  after="$(_self_fingerprint)" || return 0
  if [ -z "$before" ] || [ "$before" = "$after" ]; then
    return 0
  fi
  if [ -n "${WINGMAN_CTL_REEXECED:-}" ]; then
    # Already restarted once and it changed again — a concurrent pull, or a
    # checkout being written while this runs. Do not loop; say so and go on.
    say "  (wingman-ctl changed again after restarting once — continuing with this copy)"
    return 0
  fi
  say "→ that pull updated wingman-ctl itself — restarting so the rest of this run uses it"
  export WINGMAN_CTL_REEXECED=1
  exec "$0" ${WINGMAN_CTL_ARGV[@]+"${WINGMAN_CTL_ARGV[@]}"}
}

http_running() { wingman mcp status 2>/dev/null | grep -q 'is running'; }

print_urls() {
  # Computed straight from the token file + Tailscale detection (#94,
  # #122) — works regardless of how the server was launched (wg, systemd,
  # by hand), unlike grepping a banner that only 'wg start' ever wrote.
  wingman mcp url 2>/dev/null | sed 's/^/  /'
}

stdio_pids() {
  # wingman-mcp processes WITHOUT --http: the client-owned stdio servers.
  pgrep -f 'wingman-mcp' 2>/dev/null | while read -r pid; do
    cmd=$(ps -p "$pid" -o command= 2>/dev/null)
    case "$cmd" in
      *wingman-mcp*--http*) ;;                 # ours; managed via the pidfile
      *wingman-mcp*) printf '%s\n' "$pid" ;;
    esac
  done
}

owner_of() {
  tty=$(ps -p "$1" -o tty= 2>/dev/null | tr -d ' ')
  case "$tty" in
    '??'|'?'|'') say "Claude Desktop (GUI-spawned)" ;;
    *)           say "a Claude CLI session on $tty" ;;
  esac
}

cmd_status() {
  say "wingman $(wingman --version 2>/dev/null | awk '{print $2}')"
  say ""
  say "HTTP server (yours):"
  say "  $(wingman mcp status 2>/dev/null || say 'wingman not installed?')"
  http_running && print_urls
  say ""
  say "Client-owned stdio servers:"
  found=0
  for pid in $(stdio_pids); do
    found=1
    say "  pid $pid — owned by $(owner_of "$pid")"
  done
  [ "$found" = 0 ] && say "  none"
  say ""
  say "Safe to stop? 'wingman mcp stop' touches only a hand-started HTTP server."
  say "'$0 stop-all' also kills the client-owned ones — their sessions lose"
  say "wingman until you restart that client (Desktop: reopen app; CLI: /exit + relaunch)."
}

cmd_stop_all() {
  force="${1:-}"
  pids=$(stdio_pids)
  if [ -n "$pids" ] && [ "$force" != "-y" ]; then
    say "This will also kill client-owned servers:"
    for pid in $pids; do say "  pid $pid — $(owner_of "$pid")"; done
    say "Those clients lose wingman until restarted. Continue? [y/N]"
    read -r answer
    case "$answer" in y|Y) ;; *) say "aborted; nothing was stopped."; return 1 ;; esac
  fi
  wingman mcp stop 2>/dev/null || true
  if [ -n "$pids" ]; then
    for pid in $pids; do kill "$pid" 2>/dev/null; done
    sleep 2
    for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
    say "stdio servers stopped — restart Claude Desktop / CLI sessions to reconnect."
  fi
}

refresh_own_cli() {
  # This account's own CLI: what an operator actually types ('motd', 'qotd',
  # 'keys'). Pull, regenerate the changelog, reinstall from the pinned lock.
  # Touches no running process — callers decide what (if anything) to stop.
  say "→ refreshing $REPO from github…"
  # Discard any local regeneration of changelog_data.py left over from a
  # PRIOR run of this same command (below) — safe to drop unconditionally,
  # since it gets rebuilt fresh moments after this pull anyway. Without
  # this, a leftover uncommitted regeneration makes 'git pull --ff-only'
  # refuse to fast-forward the moment a new upstream commit also touches
  # that file — every future pull after any merge, not a one-off (#249).
  ( cd "$REPO" && git checkout -- src/wingman/changelog_data.py 2>/dev/null || true )
  _fingerprint_before_pull="$(_self_fingerprint || true)"
  ( cd "$REPO" && git pull --ff-only ) || { say "pull failed — nothing was touched"; return 1; }
  reexec_if_self_changed "$_fingerprint_before_pull"
  # Keeps the changelog from drifting silently (#202): regenerated fresh from
  # THIS pull's history right before the wheel that ships it gets built.
  # Best-effort — a checkout with a broken/absent git history (rare, but
  # possible on a shallow or detached clone) must never block the upgrade
  # itself over a data file nobody's waiting on.
  ( cd "$REPO" && uv run python3 scripts/generate_changelog.py ) \
    || say "  (changelog regeneration skipped — non-fatal, continuing)"
  say "→ reinstalling…"
  # Pinned to $REPO's own uv.lock: an unconstrained 'uv tool install'
  # resolves fresh and silently deploys versions nothing tested (#302).
  ( "$REPO/scripts/wingman-tool-install.sh" "$REPO" ) \
    || { say "reinstall failed — nothing was killed"; return 1; }
  # The new build may expect a host surface this box does not have yet
  # (RFC-072, #212). Checked right after the install, so the answer is about
  # the version now on disk, and printed rather than enforced.
  say "→ checking the host against this build's manifest…"
  wingman host-check || say "  (operational drift above — 'wingman host-check --apply' for the safe ones)"
}

cmd_upgrade() {
  # This account's CLI only. Local stdio servers are stopped afterwards
  # because they are still running the old build; the shared service is
  # NOT touched — that is 'redeploy-shared' (#292).
  refresh_own_cli || return 1
  say "→ stopping local stdio servers on the old build…"
  cmd_stop_all -y
  say ""
  wingman --version
  say "Done. Restart Claude Desktop and any CLI sessions to reconnect on the new build."
  say "(The shared service is separate: '$0 redeploy-shared' or '$0 upgrade-all'.)"
}

cmd_retired() {
  # start / stop / cycle managed a per-account HTTP server (shape B). Every
  # tenant is on the shared service now (#617), so these say where to go
  # instead of doing something that serves nobody.
  say "$0 $1: per-account servers are retired — every tenant is served by the"
  say "  shared multi-tenant service. Use '$0 redeploy-shared' to update it, or"
  say "  '$0 upgrade-all' to refresh this account's CLI and then the shared service."
  exit 2
}

cmd_redeploy_shared() {
  # The RFC-048 shared multi-tenant process, which is NOT this account's
  # instance: it runs as its own service account from its own checkout, so
  # 'upgrade' above never touches it (#292).
  #
  # Two things happen here because they always had to happen together, and
  # doing them by hand meant remembering to pull first or silently running a
  # stale copy of the redeploy script:
  #   1. refresh THIS checkout, since that is where the script being invoked
  #      lives (and re-exec if the pull changed wingman-ctl itself);
  #   2. run that script under sudo — it pulls the service account's own
  #      checkout, reinstalls, restarts, health-checks, and re-declares the
  #      host registry reservation (#288).
  local script="$REPO/scripts/wingman-redeploy-shared.sh"
  say "→ refreshing $REPO from github…"
  _fingerprint_before_pull="$(_self_fingerprint || true)"
  ( cd "$REPO" && git pull --ff-only ) || { say "pull failed — nothing was touched"; return 1; }
  reexec_if_self_changed "$_fingerprint_before_pull"
  if [ ! -x "$script" ]; then
    say "$script is missing or not executable — is $REPO a current checkout?"
    return 1
  fi
  say "→ redeploying the shared multi-tenant process (every tenant on it is"
  say "  briefly interrupted by the restart — expected, not a bug)…"
  sudo "$script"
}

cmd_upgrade_all() {
  # Everything on this box that runs wingman code (#375): this account's own
  # CLI, then the RFC-048 shared process every tenant talks to. They live in
  # different checkouts under different accounts and neither upgrades the
  # other — upgrading only the shared process lets it ship a command hours
  # before the operator's CLI can run it ("No such command").
  #
  # The cross-account systemd sweep (wingman-upgrade-all.service and its
  # timer, WINGMAN_UPGRADE_USERS) kept per-account shape-B installs current.
  # Shape B is retired (#617), so it is gone; on a host whose only service
  # is the shared one, this is 'upgrade' for your CLI plus 'redeploy-shared'.
  #
  # Order is deliberate. The CLI refresh interrupts nothing and proves the
  # tree builds, so it goes FIRST. The shared restart briefly cuts every
  # tenant off, so it goes LAST.
  local cli_ok=1 shared_ok=1 registry_stale=0 shared_rc=0

  say "→ [1/2] refreshing this account's own CLI (nothing is interrupted)…"
  refresh_own_cli || { cli_ok=0; say "  this account's CLI upgrade FAILED — see above"; }

  # Attempted even when the CLI half failed: the two are independent, and
  # refusing to update the process that serves every tenant because the
  # operator's own CLI could not be reinstalled is the wrong trade.
  say "→ [2/2] redeploying the shared multi-tenant process…"
  cmd_redeploy_shared || shared_rc=$?
  # 3 = the redeploy script's "healthy, serving, registry ledger not updated":
  # a bookkeeping gap, not an outage, so it must not get the outage wording.
  if [ "$shared_rc" = 3 ]; then
    registry_stale=1
  elif [ "$shared_rc" != 0 ]; then
    shared_ok=0
  fi

  # Never silent about a partial run: say which half did not happen, and
  # exit non-zero so a caller can tell. The redeploy script's own failures
  # leave the running process alone ("nothing was killed"), so a partial
  # result here means stale, not broken.
  if [ "$cli_ok" = 1 ] && [ "$shared_ok" = 1 ] && [ "$registry_stale" = 0 ]; then
    say "Done — this account's CLI and the shared process are both current."
    return 0
  fi
  if [ "$cli_ok" = 1 ] && [ "$shared_ok" = 1 ]; then
    say "Done, except the host service registry: the shared process is current,"
    say "  healthy and serving every tenant, but its registry entry was not updated."
    say "  Nothing is down. The redeploy output above has the commands to fix it."
    return 3
  fi
  say ""
  # Two failures, two different truths — and saying the wrong one is worse
  # than saying nothing (#415). A CLI that failed to install leaves the
  # previous one working: stale, nobody is down. A shared-process redeploy
  # that failed may have stopped the old process already, in which case
  # every tenant is DOWN.
  if [ "$cli_ok" != 1 ]; then
    say "INCOMPLETE: this account's CLI upgrade did not finish."
    say "  It keeps the build it already had — stale, not broken."
  fi
  if [ "$registry_stale" = 1 ]; then
    say "NOTE: the shared process is healthy and serving, but its host service"
    say "  registry entry was not updated (commands in the redeploy output above)."
  fi
  if [ "$shared_ok" != 1 ]; then
    say "INCOMPLETE: the shared multi-tenant process did not come up cleanly."
    say "  It may have been stopped already, in which case NO TENANT IS SERVED"
    say "  right now. Read the redeploy output above — it says which. Treat an"
    say "  unconfirmed shared process as an outage, not as a stale build."
  fi
  say "Re-run once the cause is fixed."
  return 1
}

cmd_hosts() {
  # Thin wrapper over 'wingman-host-status' (#263) — the whole-box view
  # 'status' above deliberately isn't: 'status' is YOUR instance and the
  # clients attached to it, this is every wingman on the machine, its
  # build drift, and whether anything is running outside systemd's
  # control. Its own entry point rather than a 'wingman' subcommand for
  # RFC-042's reason (the 'wingman' CLI is one workspace per invocation).
  # No sudo: /health needs no token. As root it can additionally resolve
  # other accounts' systemd state.
  if ! command -v wingman-host-status >/dev/null 2>&1; then
    say "wingman-host-status isn't installed — reinstall from this checkout ('$0 upgrade')."
    return 1
  fi
  wingman-host-status "$@"
}

#: Same default as wingman-provision-shared.sh / wingman-redeploy-shared.sh.
SHARED_USER="${WINGMAN_SHARED_USER:-wingman-shared}"

_home_of() {
  # getent is Linux; macOS needs dscl. Falls back to the conventional path
  # rather than failing, since a service account may predate either.
  local user="$1" home=""
  if command -v getent >/dev/null 2>&1; then
    home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)"
  elif command -v dscl >/dev/null 2>&1; then
    home="$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  fi
  [ -n "$home" ] || home="/home/$user"
  printf '%s' "$home"
}

require_no_args() {
  # A subcommand that takes nothing must SAY so rather than quietly doing
  # something else (#443). 'wg upgrade all' matched 'upgrade)', threw the
  # 'all' away and refreshed one account while the operator believed the
  # whole box had been done — on a pair of commands one hyphen apart whose
  # blast radius is very different. The same class of bug is already
  # documented in cmd_tenant below.
  local cmd="$1"; shift
  [ "$#" -eq 0 ] && return 0
  say "$0 $cmd: takes no arguments (got '$1')."
  case "$cmd" in
    upgrade) say "Did you mean '$0 upgrade-all'?" ;;
  esac
  exit 2
}

_run_as_shared() {
  # The tenant-owning account, by name. Kept as its own entry point because
  # every caller but one means exactly this account.
  _run_as "$SHARED_USER" "$@"
}

_run_as() {
  # Re-exec 'wingman <args>' as a NAMED account. Generalised from
  # _run_as_shared for #537: '--scope host' writes one account's
  # secrets.env, so it has to name which, and 'the shared one' is only the
  # commonest answer rather than the only one.
  #
  # Re-exec 'wingman <args>' as the account that owns the tenant registry
  # and every tenant's keys.env / token file. Extracted from cmd_keys
  # (#444) so 'tenant' gets the identical treatment: every 'wingman tenant'
  # subcommand reads those same shared-account files, and read as anyone
  # else they come back "absent" — a permissions failure wearing a
  # finding's costume (#442).
  local who="$1"; shift
  id "$who" >/dev/null 2>&1 || {
    say "no '$who' account on this box."
    [ "$who" = "$SHARED_USER" ] && say "(is the RFC-048 shared process provisioned? override with WINGMAN_SHARED_USER=...)"
    return 1
  }

  # Already the owning account: run in-process. Without this, being
  # wingman-shared would still shell out through sudo to reach itself,
  # needing sudo rights the service account has no reason to hold.
  if [ "$(id -un)" = "$who" ]; then
    command -v wingman >/dev/null 2>&1 || {
      say "no 'wingman' on PATH for $who — run '$0 upgrade-all' first"
      return 127
    }
    say "→ as $who (already this account)"
    wingman "$@"
    return $?
  fi

  # Exec the binary directly rather than going through a shell. 'sudo -i'
  # runs the target's LOGIN shell, which joins everything after it into one
  # string and re-parses it — a quoted multi-line script does not survive
  # that second parse ("syntax error: unexpected end of file"). No nested
  # shell means no quoting to get wrong, and arguments arrive verbatim.
  #
  # -H is not optional: without it sudo keeps the CALLER's HOME, so wingman
  # would read this account's ~/.config/wingman/secrets.env while announcing
  # it ran as somebody else. Silently answering about the wrong account is
  # the exact failure #442 exists to stop.
  local target_home bin
  target_home="$(_home_of "$who")"
  [ -n "$target_home" ] || {
    say "cannot resolve $who's home directory — is the account complete?"
    return 1
  }
  bin="$target_home/.local/bin/wingman"
  sudo -H -u "$who" test -x "$bin" || {
    say "no wingman at $bin — run '$0 upgrade-all' first"
    return 127
  }
  say "→ as $who ($target_home)"
  sudo -H -u "$who" "$bin" "$@"
}

cmd_keys() {
  # #444: the 'keys' commands live on the wingman CLI, but the account
  # whose keys need looking at is usually not the one you are logged in
  # as. sudo resets PATH, so every invocation had become
  #   sudo -iu wingman-shared bash -c 'export PATH=...; wingman keys ...'
  # which docs/SERVER.md had absorbed rather than solved, and which fails
  # two unhelpful ways: 'command not found', or -- worse -- running as the
  # wrong account and reading every tenant's keys.env as absent (#442).
  #
  # Unlike 'tenant', this routes CONDITIONALLY: 'wg keys where' with no
  # flags is a question about the caller's OWN account, and answering it as
  # somebody else would be the same wrong-account bug in reverse.
  local as_shared=0 arg scope_host=0 named_account=0 prev=""
  for arg in "$@"; do
    case "$arg" in
      --all-tenants|--tenant|--tenant=*) as_shared=1 ;;
      # '--scope host' writes ~/.config/wingman/secrets.env, and WHOSE home
      # that is decides everything. Run as the caller it writes the caller's
      # file and reports success, while the operator believes they set the
      # box default -- the third outing for one bug (#442 called an
      # unreadable tier absent; #447 wrote the caller's HOME under sudo -u;
      # this is #537). An account-scoped write must name its account.
      host) [ "$prev" = "--scope" ] && scope_host=1 ;;
      --scope=host) scope_host=1 ;;
      --as|--as=*) named_account=1 ;;
    esac
    prev="$arg"
  done

  if [ "$scope_host" -eq 1 ] && [ "$named_account" -eq 0 ]; then
    say "$0 keys set --scope host: name the account whose file to write."
    say "  this account:   $0 keys set <name> --scope host --as $(id -un)"
    say "  the shared one: $0 keys set <name> --scope host --as $SHARED_USER"
    say "Refusing rather than guessing: '--scope host' writes one account's"
    say "secrets.env, and writing the wrong one looks exactly like success."
    return 2
  fi

  # '--as <account>' is wingman-ctl's own flag: it picks whose CLI runs, and
  # is stripped before forwarding so the Python side never sees it.
  local target="" forwarded=() skip_next=0
  for arg in "$@"; do
    if [ "$skip_next" -eq 1 ]; then target="$arg"; skip_next=0; continue; fi
    case "$arg" in
      --as)   skip_next=1 ;;
      --as=*) target="${arg#--as=}" ;;
      *)      forwarded+=("$arg") ;;
    esac
  done
  if [ -n "$target" ]; then
    set -- ${forwarded[@]+"${forwarded[@]}"}
    if [ "$target" = "$(id -un)" ]; then
      as_shared=0
    else
      _run_as "$target" keys "$@"
      return $?
    fi
  fi

  if [ "$as_shared" -eq 0 ]; then
    command -v wingman >/dev/null 2>&1 || {
      say "no 'wingman' on PATH for $(id -un) — is the CLI installed for this account?"
      return 127
    }
    say "→ as $(id -un) (this account)"
    wingman keys "$@"
    return $?
  fi

  _run_as_shared keys "$@"
}

cmd_tenant() {
  # Every 'wingman tenant' subcommand reads files that belong to the shared
  # service account -- the registry, each tenant's keys.env, each tenant's
  # token file -- so this routes through _run_as_shared unconditionally.
  # That is the difference from cmd_keys, which routes only when a
  # tenant-scoped flag is present: there is no such thing as an
  # own-account 'tenant' question.
  #
  # Before this, 'wg tenant url <slug>' ran as the CALLER and could not read
  # the tenant's token file, so it reported a URL it had failed to build --
  # which is why wingman-provision-shared.sh's own status hint had to spell
  # out a 'sudo -iu wingman-shared bash -c export PATH=...' incantation
  # instead of just saying 'wg tenant url <slug>'.
  local sub="${1:-}" slug="${2:-}"
  case "$sub" in
    keys)
      shift
      _run_as_shared tenant keys "$@" ;;
    reload)
      shift
      _run_as_shared tenant reload "$@" ;;
    url)
      [ -n "$slug" ] || { say "usage: $0 tenant url <slug> [--port N] [--tunnel-prefix /path] ..."; return 2; }
      shift 2
      _run_as_shared tenant url "$slug" "$@" ;;
    urls)
      shift
      _run_as_shared tenant urls "$@" ;;
    validate)
      shift
      _run_as_shared tenant validate "$@" ;;
    rotate-token)
      [ -n "$slug" ] || { say "usage: $0 tenant rotate-token <slug>"; return 2; }
      shift 2
      _run_as_shared tenant rotate-token "$slug" "$@" ;;
    *)
      say "usage: $0 tenant keys [--tenant <slug>] | tenant validate [--tenant <slug>]"
      say "       $0 tenant reload   (apply a registry edit; no restart)"
      say "       $0 tenant url <slug> | tenant urls | tenant rotate-token <slug>"
      return 2 ;;
  esac
}

case "${1:-}" in
  status)      shift; require_no_args status "$@"; cmd_status ;;
  start|stop|cycle) cmd_retired "$1" ;;
  stop-all)    cmd_stop_all "${2:-}" ;;
  upgrade)     shift; require_no_args upgrade "$@"; cmd_upgrade ;;
  upgrade-all) shift; require_no_args upgrade-all "$@"; cmd_upgrade_all ;;
  redeploy-shared) shift; require_no_args redeploy-shared "$@"; cmd_redeploy_shared ;;
  hosts)       shift; cmd_hosts "$@" ;;
  keys)        shift; cmd_keys "$@" ;;
  reload)      shift; require_no_args reload "$@"; cmd_tenant reload ;;
  tenant)      shift; cmd_tenant "$@" ;;
  *)
    say "usage: $0 status|hosts|keys|reload|stop-all [-y]|upgrade|upgrade-all|redeploy-shared|tenant ..."
    say "  status       what's running for YOU: local stdio servers and who owns each"
    say "  hosts        every wingman instance on this box: version, uptime, build drift,"
    say "               and whether any is running outside systemd's control (#263)"
    say "  stop-all     local client-owned stdio servers (asks first; -y skips)"
    say "  upgrade      this account's CLI: pull → reinstall → stop local stdio servers."
    say "               Does NOT touch the shared service"
    say "  upgrade-all  EVERYTHING on this box: this account's CLI first (nothing is"
    say "               interrupted), then the shared multi-tenant process every tenant"
    say "               talks to. Needs sudo; says which half did not happen (#375)"
    say "  redeploy-shared  pull, then redeploy the RFC-048 shared multi-tenant process"
    say "               (needs sudo; briefly interrupts every tenant on it)"
    say "  keys ...     forward to 'wingman keys' with a working PATH; tenant-scoped"
    say "               flags (--tenant/--all-tenants) run as the account that owns"
    say "               the registry, so tenant files are readable (#442, #444)"
    say "  tenant keys [--tenant <slug>]  which key each person actually uses, by"
    say "                              fingerprint only -- the strict RFC-048 ladder"
    say "                              (their workspace keys.env, then the global file"
    say "                              only if funded), never the operator's host file"
    say "  tenant validate [--tenant <slug>]  call the provider with the key that"
    say "                              person actually spends, on the strict ladder"
    say "  reload       apply a tenant-registry edit to the RUNNING shared process"
    say "               (SIGHUP, no restart). Changing a KEY needs nothing at all;"
    say "               only registry edits need this. See 'redeploy-shared' (#534)"
    say "  tenant url <slug>           print a tenant's connector URLs (RFC-048, #209)"
    say "  tenant urls                 the same, for every registered tenant"
    say "  tenant rotate-token <slug>  invalidate + reissue a tenant's token in one step,"
    say "                              no restart, no drain (RFC-048, #210)"
    say "  every 'tenant' subcommand runs as the account owning the tenant files (#442)"
    say "  start, stop and cycle are retired: per-account servers are gone (#617)"
    exit 2 ;;
esac
