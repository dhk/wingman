.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.scratch/
dist/
build/
*.egg-info/

# Private and generated Wingman data
data/*
!data/inbox/.gitkeep
reports/*
!reports/.gitkeep

# Local model traces and credentials
traces/
secrets/

# Written by scripts/wingman-tool-install.sh while pinning an install to
# uv.lock; removed on exit, but a killed run must not leave a tracked file.
.tool-constraints.txt

# Agent worktrees live here and are not part of the repo — but the session
# hook and its settings are the repo's, not one developer's: a hook nobody
# gets on checkout is a hook that does not run where it is needed (a fresh
# Claude Code on the web container). '.claude/*' still excludes the
# worktrees, and 'settings.local.json' with them.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
