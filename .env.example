# Add provider keys only when a feature requires them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override for the workspace location. When unset, Wingman uses the
# platform user data directory (e.g. ~/.local/share/wingman on Linux).
# Development checkouts typically set it to keep data inside the repo:
WINGMAN_DATA_DIR=./data
# Development only: scripts/oss_review.py (docs/OSS-REVIEW.md). Not used by Wingman itself.
AI_GATEWAY_API_KEY=
# OSS_REVIEW_API_KEY=        # for a provider other than Vercel AI Gateway
# OSS_REVIEW_BASE_URL=https://ai-gateway.vercel.sh/v1
# OSS_REVIEW_MODEL=deepseek/deepseek-v4.1-flash-1017
